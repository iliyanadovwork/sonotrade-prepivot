# Server Configuration
PORT=5001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sonotrade

# Redis Configuration (for caching Kalshi API requests)
# Local: redis://localhost:6379
# Production: Use your Redis provider URL (e.g., Redis Cloud, Upstash, etc.)
REDIS_URL=redis://localhost:6379

# JWT Configuration (Generate secure random strings for these)
# You can generate these using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-here
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-here

# Encryption Configuration (Generate a 32-byte hex string)
# You can generate this using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Resend Email Service Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# DFlow API Configuration
# Get your API key from DFlow
DFLOW_API_KEY=your-dflow-api-key-here
DFLOW_API_URL=https://c.prediction-markets-api.dflow.net

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Platform Sponsor Wallet (for gasless transactions)
# Generate using: npx ts-node scripts/generate-sponsor-wallet.ts
# This wallet pays ALL user transaction fees (trades, withdrawals)
# Keep this wallet funded with SOL (~0.5-1 SOL recommended)
SPONSOR_PRIVATE_KEY=your-base64-encoded-sponsor-private-key-here

# Admin Panel Login (hardcoded credentials for admin dashboard)
ADMIN_EMAIL=admin@sonotrade.io
ADMIN_PASSWORD=changeme
